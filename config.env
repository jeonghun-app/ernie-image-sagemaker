# ERNIE-Image SageMaker endpoint settings. Edit here, or run: ./ernie.sh config set KEY VALUE
# Lines are KEY=VALUE (no spaces around "=").

# Region. Empty = the CloudShell region (AWS_REGION).
REGION=
# Name prefix for every resource (lowercase letters, digits, hyphens; up to 40 chars).
NAME=ernie-image

# Instances. Only ml.g6e.12xlarge (4 x NVIDIA L40S) is verified: one model copy per GPU.
INSTANCE_TYPE=ml.g6e.12xlarge
# Instances to start with (install).
INSTANCE_COUNT=1
# Upper limit for "./ernie.sh scale N". Changing it later requires delete + install.
MAX_INSTANCES=10
# Model copies per instance (= GPUs per instance). Do not change for ml.g6e.12xlarge.
COPIES_PER_INSTANCE=4
# Minutes SageMaker waits after the last change before consolidating copies and releasing idle instances (5-1440).
SCALE_IN_COOLDOWN_MINUTES=5
# true = spread model copies evenly across Availability Zones (resilience). false = pack copies onto as few
# instances as possible, so "scale" down releases instances sooner. Instances themselves are spread by SageMaker.
AZ_BALANCE=false

# Model and container (verified values).
MODEL_ID=baidu/ERNIE-Image
IMAGE_TAG=omni-sagemaker-cuda-v1.3.1

# IAM execution role for SageMaker. Created by install if it does not exist.
ROLE_NAME=ernie-image-sagemaker-role

# Network (optional).
# Empty = SageMaker-managed network (default, simplest): SageMaker chooses the AZs; no subnet/IP planning needed.
# Set both to run the instances in YOUR VPC subnets (VpcConfig). Then:
#   - instances are placed only in the AZs of these subnets -> give 2+ subnets in different AZs for GPU capacity
#   - each subnet needs free IPs, and a route to the internet (NAT gateway) to download the model from Hugging Face
#   - list candidates with: ./ernie.sh subnets [vpc-id]
SUBNET_IDS=
SECURITY_GROUP_IDS=
